{
  "name": "astro-hydrogen",
  "version": "0.1.0",
  "description": "Astro adapter for Shopify Hydrogen: deploy to Oxygen and get a request-scoped Storefront API client in every page, with no UI framework required.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "withastro",
    "astro-adapter",
    "astro-integration",
    "shopify",
    "hydrogen",
    "oxygen",
    "headless-commerce"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./entrypoints/server": {
      "types": "./dist/entrypoints/server.d.ts",
      "default": "./dist/entrypoints/server.js"
    },
    "./entrypoints/middleware": {
      "types": "./dist/entrypoints/middleware.d.ts",
      "default": "./dist/entrypoints/middleware.js"
    },
    "./entrypoints/preview": {
      "types": "./dist/entrypoints/preview.d.ts",
      "default": "./dist/entrypoints/preview.js"
    },
    "./types.d.ts": "./types.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@shopify/mini-oxygen": "^4.2.3",
    "rolldown": "~1.2.12"
  },
  "peerDependencies": {
    "@shopify/hydrogen": ">=2026.10.0",
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@shopify/hydrogen": "2026.10.1",
    "@shopify/oxygen-workers-types": "^4.2.0",
    "@types/node": "^22.10.6",
    "astro": "7.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.7"
  },
  "engines": {
    "node": "^22.12 || ^24"
  }
}
